# Not needed for local development: `npm run dev` proxies /api and /media to the Django backend on
# 127.0.0.1:8000. On the server these are written to .env.production.local by deploy/setup.sh.

# Browser → API (same domain, via Nginx)
NEXT_PUBLIC_API_URL=/api
# Website server → API directly (contact details, blog)
INTERNAL_API_URL=http://127.0.0.1:8000/api
# Shared with the backend, so saving in the admin panel refreshes the website straight away
REVALIDATE_SECRET=change-me
